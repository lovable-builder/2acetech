msgid "Show a countdown"
msgstr "Pokaż odliczanie"

#: inc/banner.php:384
msgid "Countdown ends on"
msgstr "Odliczanie kończy się"

#: inc/banner.php:384
msgid ""
"Date and time in your site time zone. No countdown is shown while this is "
"empty."
msgstr ""
"Data i godzina w strefie czasowej strony. Dopóki pole jest puste, odliczanie "
"się nie pokazuje."

#: inc/banner.php:385
msgid "Text above the countdown"
msgstr "Tekst nad odliczaniem"

#: inc/banner.php:386
msgid "Text when the countdown is over"
msgstr "Tekst po zakończeniu odliczania"

#: inc/banner.php:386
msgid ""
"Shown instead of the countdown. To remove the whole banner at that moment, "
"also set \"Show until\"."
msgstr ""
"Pokazywany zamiast odliczania. Aby w tym momencie usunąć cały baner, ustaw "
"też „Pokaż do”."

#: inc/banner.php:389
msgid "Show from (optional)"
msgstr "Pokaż od (opcjonalnie)"

#: inc/banner.php:389
msgid "Empty = from now on."
msgstr "Puste = od teraz."

#: inc/banner.php:390
msgid "Show until (optional)"
msgstr "Pokaż do (opcjonalnie)"

#: inc/banner.php:390
msgid "Empty = no end. After this moment the banner disappears by itself."
