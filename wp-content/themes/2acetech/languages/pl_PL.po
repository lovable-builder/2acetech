msgid "Product IDs or SKUs"
msgstr "ID lub SKU produktów"

#: inc/banner.php:379
msgid ""
"Separated by commas, in the order you want them, for example: 592, 2AC-0003, "
"675."
msgstr ""
"Oddzielone przecinkami, w żądanej kolejności, na przykład: 592, 2AC-0003, "
"675."

